ARG FEDORA_RELEASE=41

FROM quay.io/fedora/fedora-silverblue:${FEDORA_RELEASE}

ARG FEDORA_RELEASE

COPY --chown=root:root --chmod=644 files/policy.json /etc/containers/policy.json
COPY --chown=root:root --chmod=644 files/ghcr.io.yaml /etc/containers/registries.d/ghcr.io.yaml
COPY --chown=root:root --chmod=644 files/brave.repo /etc/yum.repos.d/brave.repo
COPY --chown=root:root --chmod=644 files/tailscale.repo /etc/yum.repos.d/tailscale.repo
COPY --chown=root:root --chmod=644 files/vscode.repo /etc/yum.repos.d/vscode.repo

RUN sed --in-place 's/enabled = no/enabled = true/' \
	/usr/lib/ostree/prepare-root.conf && \
	printf 'fastestmirror=True\nmax_parallel_downloads=8' >> /etc/dnf/dnf.conf && \
	mkdir --parents /usr/opt && \
	ln --symbolic --force usr/opt /opt

RUN dnf --assumeyes remove \
	firefox \
	&& \
	dnf --assumeyes upgrade && \
	dnf --assumeyes install --allowerasing \
	# CLI
	distrobox \
	dua-cli \
	fish \
	helix \
	htop \
	iotop-c \
	nvtop \
	# GUI
	brave-browser \
	breeze-cursor-theme \
	papirus-icon-theme \
	tailscale \
	# Devel
	code \
	podman-compose \
	podman-docker \
	podman-tui \
	virt-manager \
	# Fonts
	cascadia-fonts-all \
	default-fonts \
	liberation-fonts-all \
	# Gnome
	gnome-shell-extension-appindicator \
	gnome-shell-extension-argos \
	gnome-shell-extension-caffeine \
	gnome-shell-extension-gsconnect \
	&& \
	# Systemd
	systemctl enable tailscaled.service && \
	# Cleanup
	dnf clean all && \
	rm -frv /var/* && \
	ostree container commit

RUN bootc container lint
